{
  "unstable": ["kv"],
  "fmt": {
    "exclude": ["docs/"]
  },
  "tasks": {
    "dev": "deno --watch --tunnel -EN main.ts",
    "ok": "deno fmt --check && deno lint && deno check",
    "setwh": "sh -c 'curl --get --data-urlencode \"url=${1:?Webhook URL is required}\" \"https://api.telegram.org/bot${BOT_TOKEN:?BOT_TOKEN is required}/setwebhook\"' --"
  },
  "imports": {
    "@grammyjs/grammy": "jsr:@grammyjs/grammy@2.0.0-beta.7",
    "@hono/hono": "jsr:@hono/hono@^4.13.1",
    "grammy": "jsr:@grammyjs/grammy@2.0.0-beta.7"
  },
  "deploy": {
    "org": "knorpeltest",
    "app": "liverichpreviewbot"
  }
}
